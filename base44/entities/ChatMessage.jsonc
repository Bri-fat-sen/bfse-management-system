{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_photo": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string",
      "description": "For direct messages"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file",
        "product",
        "system",
        "announcement"
      ],
      "default": "text"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "attachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image",
            "file",
            "product"
          ]
        },
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "mimeType": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "productName": {
          "type": "string"
        },
        "productSku": {
          "type": "string"
        },
        "productPrice": {
          "type": "number"
        },
        "productImage": {
          "type": "string"
        },
        "productStock": {
          "type": "number"
        }
      },
      "description": "Attachment details for files, images, or product references"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_content": {
      "type": "string"
    },
    "reply_to_sender": {
      "type": "string"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "important",
        "urgent"
      ],
      "default": "normal"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "policy",
        "event",
        "hr",
        "safety",
        "training"
      ],
      "default": "general"
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "edited_at": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "pinned_by": {
      "type": "string"
    },
    "pinned_at": {
      "type": "string"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "sender_photo": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    },
    "acknowledgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "user_photo": {
            "type": "string"
          },
          "acknowledged_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "organisation_id",
    "sender_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "sender_id": "{{employee.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "sender_id": "{{employee.id}}"
        }
      ]
    }
  }
}
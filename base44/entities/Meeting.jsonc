{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "duration_mins": {
      "type": "number"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "in_person",
        "video",
        "audio"
      ],
      "default": "in_person"
    },
    "location": {
      "type": "string"
    },
    "meeting_link": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attendee_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    },
    "actual_attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "monthly"
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "endType": {
          "type": "string",
          "enum": [
            "never",
            "after",
            "on"
          ]
        },
        "occurrences": {
          "type": "number"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Reminder times in minutes before meeting"
    },
    "parent_meeting_id": {
      "type": "string",
      "description": "For recurring meeting instances, reference to parent"
    }
  },
  "required": [
    "organisation_id",
    "title",
    "date",
    "start_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organizer_id": "{{employee.id}}"
        },
        {
          "attendees": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organizer_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organizer_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
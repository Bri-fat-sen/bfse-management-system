{
  "name": "VehicleMaintenance",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "maintenance_type": {
      "type": "string",
      "enum": [
        "oil_change",
        "tire_rotation",
        "tire_replacement",
        "brake_service",
        "engine_repair",
        "transmission",
        "battery",
        "air_filter",
        "fuel_filter",
        "coolant_flush",
        "inspection",
        "body_repair",
        "electrical",
        "scheduled_service",
        "other"
      ],
      "default": "scheduled_service"
    },
    "category": {
      "type": "string",
      "enum": [
        "scheduled",
        "unscheduled",
        "emergency"
      ],
      "default": "scheduled"
    },
    "description": {
      "type": "string"
    },
    "date_performed": {
      "type": "string",
      "format": "date"
    },
    "mileage_at_service": {
      "type": "number"
    },
    "cost": {
      "type": "number",
      "default": 0
    },
    "vendor": {
      "type": "string"
    },
    "vendor_contact": {
      "type": "string"
    },
    "parts_replaced": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "next_due_mileage": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "in_progress",
        "scheduled",
        "cancelled"
      ],
      "default": "completed"
    },
    "performed_by": {
      "type": "string"
    },
    "performed_by_name": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "vehicle_id",
    "maintenance_type",
    "date_performed"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "warehouse_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "performed_by": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "warehouse_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "performed_by": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "warehouse_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
{
  "name": "PayrollRun",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "run_number": {
      "type": "string",
      "description": "Unique payroll run identifier"
    },
    "name": {
      "type": "string",
      "description": "Name/description of this payroll run"
    },
    "payroll_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "bi_weekly",
        "monthly"
      ],
      "default": "monthly"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "pending_approval",
        "approved",
        "processing",
        "paid",
        "cancelled"
      ],
      "default": "draft"
    },
    "employee_count": {
      "type": "number",
      "default": 0
    },
    "total_gross": {
      "type": "number",
      "default": 0
    },
    "total_deductions": {
      "type": "number",
      "default": 0
    },
    "total_net": {
      "type": "number",
      "default": 0
    },
    "total_employer_cost": {
      "type": "number",
      "default": 0
    },
    "total_nassit_employee": {
      "type": "number",
      "default": 0
    },
    "total_nassit_employer": {
      "type": "number",
      "default": 0
    },
    "total_paye": {
      "type": "number",
      "default": 0
    },
    "payroll_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of individual payroll records in this run"
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "submitted_by_id": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approval_notes": {
      "type": "string"
    },
    "rejected_by_id": {
      "type": "string"
    },
    "rejected_by_name": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "period_start",
    "period_end"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
{
  "name": "Sale",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "sale_number": {
      "type": "string"
    },
    "sale_type": {
      "type": "string",
      "enum": [
        "retail",
        "warehouse",
        "vehicle"
      ],
      "default": "retail"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "mobile_money",
        "credit"
      ],
      "default": "cash"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "partial"
      ],
      "default": "paid"
    },
    "notes": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "source_document_id": {
      "type": "string",
      "description": "Link to uploaded document that created this record"
    }
  },
  "required": [
    "organisation_id",
    "sale_type",
    "total_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "employee_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
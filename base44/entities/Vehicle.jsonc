{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "bus",
        "minibus",
        "truck",
        "van",
        "motorcycle",
        "car"
      ],
      "default": "bus"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "capacity": {
      "type": "number"
    },
    "assigned_driver_id": {
      "type": "string"
    },
    "assigned_driver_name": {
      "type": "string"
    },
    "parent_warehouse_id": {
      "type": "string",
      "description": "The warehouse this vehicle is linked to for stock tracking"
    },
    "parent_warehouse_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "inactive"
      ],
      "default": "active"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "petrol",
        "diesel",
        "electric"
      ],
      "default": "diesel"
    },
    "current_mileage": {
      "type": "number",
      "default": 0
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "registration_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "assigned_driver_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "warehouse_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
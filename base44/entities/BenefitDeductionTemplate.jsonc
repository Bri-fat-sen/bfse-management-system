{
  "name": "BenefitDeductionTemplate",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Name of the benefit or deduction"
    },
    "type": {
      "type": "string",
      "enum": [
        "benefit",
        "deduction"
      ],
      "description": "Whether this is a benefit (adds to pay) or deduction (subtracts)"
    },
    "category": {
      "type": "string",
      "enum": [
        "statutory",
        "voluntary",
        "loan",
        "advance",
        "allowance",
        "bonus",
        "insurance",
        "pension",
        "other"
      ],
      "default": "other"
    },
    "calculation_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage",
        "tiered"
      ],
      "default": "fixed",
      "description": "How the amount is calculated"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Fixed amount or percentage value"
    },
    "percentage_of": {
      "type": "string",
      "enum": [
        "base_salary",
        "gross_pay"
      ],
      "default": "base_salary",
      "description": "What the percentage is calculated from"
    },
    "is_taxable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this benefit is subject to tax"
    },
    "applies_to_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles this applies to (empty = all roles)"
    },
    "applies_to_employees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific employee IDs this applies to"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "name",
    "type",
    "calculation_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
{
  "name": "SerializedItem",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "serial_number": {
      "type": "string",
      "description": "Unique serial number for the item"
    },
    "batch_id": {
      "type": "string",
      "description": "Reference to InventoryBatch if applicable"
    },
    "batch_number": {
      "type": "string"
    },
    "location_id": {
      "type": "string",
      "description": "Current warehouse or vehicle ID"
    },
    "location_name": {
      "type": "string"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "warehouse",
        "vehicle",
        "store"
      ],
      "default": "warehouse"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_stock",
        "sold",
        "reserved",
        "damaged",
        "returned",
        "in_transit"
      ],
      "default": "in_stock"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "refurbished",
        "used",
        "damaged"
      ],
      "default": "new"
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "sale_price": {
      "type": "number",
      "default": 0
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "sold_date": {
      "type": "string",
      "format": "date"
    },
    "sale_id": {
      "type": "string",
      "description": "Reference to Sale when sold"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attributes": {
      "type": "object",
      "description": "Additional custom attributes like color, size, etc."
    }
  },
  "required": [
    "organisation_id",
    "product_id",
    "serial_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "warehouse_manager"
              }
            },
            {
              "user_condition": {
                "role": "retail_cashier"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "warehouse_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
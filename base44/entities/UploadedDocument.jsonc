{
  "name": "UploadedDocument",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "description": "File extension or MIME type"
    },
    "file_size": {
      "type": "number",
      "default": 0,
      "description": "File size in bytes"
    },
    "category": {
      "type": "string",
      "enum": [
        "expense",
        "revenue",
        "production",
        "inventory",
        "payroll",
        "hr_document",
        "contract",
        "legal",
        "other"
      ],
      "default": "other"
    },
    "uploaded_by_id": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extracted_data": {
      "type": "object",
      "description": "Summary of extracted data from document"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization and search"
    },
    "linked_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "entity_name": {
            "type": "string"
          },
          "created_date": {
            "type": "string"
          }
        }
      },
      "description": "Records created from this document"
    },
    "version_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_by_name": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Version history for document updates"
    },
    "current_version": {
      "type": "number",
      "default": 1,
      "description": "Current version number"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organisation_id",
    "file_name",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "uploaded_by_id": "{{employee.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
{
  "name": "Organisation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organisation name"
    },
    "code": {
      "type": "string",
      "description": "Unique organisation code for login"
    },
    "logo_url": {
      "type": "string",
      "description": "Organisation logo URL"
    },
    "currency": {
      "type": "string",
      "default": "SLE",
      "description": "Default currency"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Sierra Leone"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary email address"
    },
    "additional_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional email addresses for the organisation"
    },
    "website": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "professional",
        "enterprise"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active"
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Freetown"
    },
    "primary_color": {
      "type": "string",
      "default": "#1EB053"
    },
    "secondary_color": {
      "type": "string",
      "default": "#1D5FC3"
    },
    "tin_number": {
      "type": "string",
      "description": "Tax Identification Number (NRA)"
    },
    "tin_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "business_registration_number": {
      "type": "string",
      "description": "OARG Business Registration Number"
    },
    "business_registration_date": {
      "type": "string",
      "format": "date"
    },
    "business_license_number": {
      "type": "string",
      "description": "Local Council Business License"
    },
    "business_license_expiry": {
      "type": "string",
      "format": "date"
    },
    "nassit_number": {
      "type": "string",
      "description": "NASSIT Employer Registration Number"
    },
    "nassit_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "gst_number": {
      "type": "string",
      "description": "Goods and Services Tax Number"
    },
    "gst_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "import_export_license": {
      "type": "string",
      "description": "Import/Export License Number"
    },
    "import_export_expiry": {
      "type": "string",
      "format": "date"
    },
    "fire_certificate_number": {
      "type": "string",
      "description": "Fire Service Certificate"
    },
    "fire_certificate_expiry": {
      "type": "string",
      "format": "date"
    },
    "health_certificate_number": {
      "type": "string",
      "description": "Health & Sanitation Certificate"
    },
    "health_certificate_expiry": {
      "type": "string",
      "format": "date"
    },
    "slra_license_number": {
      "type": "string",
      "description": "SLRA Road Transport License"
    },
    "slra_license_expiry": {
      "type": "string",
      "format": "date"
    },
    "environmental_permit_number": {
      "type": "string",
      "description": "EPA Environmental Permit"
    },
    "environmental_permit_expiry": {
      "type": "string",
      "format": "date"
    },
    "slsb_registration": {
      "type": "string",
      "description": "Sierra Leone Standards Bureau Registration"
    },
    "slsb_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "trade_license_number": {
      "type": "string",
      "description": "Ministry of Trade License"
    },
    "trade_license_expiry": {
      "type": "string",
      "format": "date"
    },
    "other_permits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "issuing_authority": {
            "type": "string"
          },
          "issue_date": {
            "type": "string",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "document_url": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Additional permits and certificates"
    },
    "auth_config": {
      "type": "object",
      "properties": {
        "auth_type": {
          "type": "string",
          "enum": [
            "email",
            "google_sso",
            "microsoft_sso",
            "custom_sso"
          ],
          "default": "email",
          "description": "Authentication method for this organisation"
        },
        "allow_email_signup": {
          "type": "boolean",
          "default": true,
          "description": "Allow users to sign up with email/password"
        },
        "restrict_email_domain": {
          "type": "boolean",
          "default": false,
          "description": "Only allow emails from specific domains"
        },
        "allowed_email_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of allowed email domains (e.g., company.com)"
        },
        "google_client_id": {
          "type": "string",
          "description": "Google OAuth Client ID"
        },
        "google_client_secret": {
          "type": "string",
          "description": "Google OAuth Client Secret (encrypted)"
        },
        "microsoft_client_id": {
          "type": "string",
          "description": "Microsoft OAuth Client ID"
        },
        "microsoft_client_secret": {
          "type": "string",
          "description": "Microsoft OAuth Client Secret (encrypted)"
        },
        "microsoft_tenant_id": {
          "type": "string",
          "description": "Microsoft Azure AD Tenant ID"
        },
        "custom_oauth_provider": {
          "type": "string",
          "description": "Custom OAuth provider name"
        },
        "custom_oauth_client_id": {
          "type": "string"
        },
        "custom_oauth_client_secret": {
          "type": "string"
        },
        "custom_oauth_authorize_url": {
          "type": "string"
        },
        "custom_oauth_token_url": {
          "type": "string"
        },
        "custom_oauth_userinfo_url": {
          "type": "string"
        },
        "saml_enabled": {
          "type": "boolean",
          "default": false
        },
        "saml_entry_point": {
          "type": "string"
        },
        "saml_issuer": {
          "type": "string"
        },
        "saml_cert": {
          "type": "string"
        }
      },
      "description": "Organisation-specific authentication configuration"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
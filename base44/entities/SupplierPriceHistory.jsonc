{
  "name": "SupplierPriceHistory",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "old_price": {
      "type": "number"
    },
    "new_price": {
      "type": "number"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_order_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "supplier_id",
    "product_id",
    "new_price"
  ],
  "rls": {
    "create": {
      "organisation_id": "{{employee.organisation_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_manager"
          }
        }
      ]
    },
    "read": {
      "organisation_id": "{{employee.organisation_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {},
    "delete": {}
  }
}
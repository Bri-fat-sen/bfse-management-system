{
  "name": "Notification",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string",
      "description": "Employee ID of recipient"
    },
    "recipient_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "chat",
        "meeting",
        "low_stock",
        "payroll",
        "transport",
        "system",
        "hr",
        "approval",
        "alert"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "recipient_id": "{{employee.id}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "recipient_id": "{{employee.id}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "recipient_id": "{{employee.id}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    }
  }
}
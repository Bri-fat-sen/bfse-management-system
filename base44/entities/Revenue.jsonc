{
  "name": "Revenue",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "owner_contribution",
        "ceo_contribution",
        "investor_funding",
        "loan",
        "grant",
        "dividend",
        "other"
      ],
      "default": "owner_contribution",
      "description": "Source of the revenue/funds"
    },
    "contributor_name": {
      "type": "string",
      "description": "Name of the owner, CEO, or contributor"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "SLE"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "cheque",
        "mobile_money",
        "other"
      ],
      "default": "bank_transfer"
    },
    "reference_number": {
      "type": "string",
      "description": "Bank reference or transaction ID"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose or reason for the contribution"
    },
    "notes": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string",
      "description": "URL to uploaded receipt or proof"
    },
    "recorded_by": {
      "type": "string"
    },
    "recorded_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "confirmed"
    },
    "source_document_id": {
      "type": "string",
      "description": "Link to uploaded document that created this record"
    }
  },
  "required": [
    "organisation_id",
    "source",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
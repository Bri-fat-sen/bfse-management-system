{
  "name": "RemunerationPackage",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Package name e.g. 'Senior Manager Package'"
    },
    "applicable_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles this package applies to"
    },
    "base_salary": {
      "type": "number",
      "default": 0,
      "description": "Monthly base salary"
    },
    "hourly_rate": {
      "type": "number",
      "default": 0,
      "description": "Hourly rate for hourly employees"
    },
    "salary_type": {
      "type": "string",
      "enum": [
        "monthly",
        "hourly",
        "daily"
      ],
      "default": "monthly"
    },
    "allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "fixed",
              "percentage"
            ]
          }
        }
      },
      "description": "Standard allowances included"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      },
      "description": "Benefits like health insurance, pension contribution"
    },
    "bonuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "monthly",
              "quarterly",
              "annual"
            ]
          }
        }
      }
    },
    "leave_entitlement": {
      "type": "object",
      "properties": {
        "annual_days": {
          "type": "number",
          "default": 21
        },
        "sick_days": {
          "type": "number",
          "default": 10
        },
        "maternity_days": {
          "type": "number",
          "default": 90
        },
        "paternity_days": {
          "type": "number",
          "default": 5
        }
      }
    },
    "overtime_rate_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "probation_period_months": {
      "type": "number",
      "default": 3
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "hr_admin"
              }
            },
            {
              "user_condition": {
                "role": "payroll_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
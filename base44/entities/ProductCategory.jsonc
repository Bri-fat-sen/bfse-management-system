{
  "name": "ProductCategory",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent_category_id": {
      "type": "string",
      "description": "For subcategories"
    },
    "color": {
      "type": "string",
      "default": "#1EB053"
    },
    "icon": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organisation_id",
    "name"
  ],
  "rls": {
    "create": {
      "organisation_id": "{{employee.organisation_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_manager"
          }
        }
      ]
    },
    "read": {
      "organisation_id": "{{employee.organisation_id}}"
    },
    "update": {
      "organisation_id": "{{employee.organisation_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_manager"
          }
        }
      ]
    },
    "delete": {
      "organisation_id": "{{employee.organisation_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_manager"
          }
        }
      ]
    }
  }
}
{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "login",
        "logout",
        "clock_in",
        "clock_out",
        "sale",
        "inventory",
        "hr_action",
        "payroll",
        "chat",
        "call",
        "meeting",
        "trip",
        "expense",
        "settings",
        "error",
        "other"
      ]
    },
    "module": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "old_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "device_info": {
      "type": "string"
    },
    "location": {
      "type": "string"
    }
  },
  "required": [
    "action_type",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {},
    "delete": {}
  }
}
{
  "name": "CustomerInteraction",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "visit",
        "complaint",
        "inquiry",
        "follow_up",
        "sale",
        "support",
        "other"
      ],
      "default": "call"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "successful",
        "pending",
        "follow_up_needed",
        "no_response",
        "negative"
      ],
      "default": "pending"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "interaction_date": {
      "type": "string",
      "format": "date"
    },
    "next_follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "related_sale_id": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "organisation_id",
    "customer_id",
    "interaction_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "employee_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "user_condition": {
                "role": "retail_cashier"
              }
            },
            {
              "user_condition": {
                "role": "vehicle_sales"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "employee_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "employee_id": "{{employee.id}}"
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
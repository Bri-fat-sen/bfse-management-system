{
  "name": "OrganisationJoinRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user requesting to join"
    },
    "user_name": {
      "type": "string",
      "description": "Full name of user"
    },
    "organisation_id": {
      "type": "string",
      "description": "Organisation user wants to join"
    },
    "organisation_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "requested_role": {
      "type": "string",
      "enum": [
        "read_only",
        "support_staff",
        "retail_cashier",
        "vehicle_sales",
        "driver",
        "warehouse_manager",
        "accountant",
        "hr_admin",
        "payroll_admin"
      ],
      "default": "read_only",
      "description": "Role requested by user"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "employee_id": {
      "type": "string",
      "description": "Created employee ID after approval"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "organisation_id",
    "user_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "{{user.email}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "organisation_id": "{{employee.organisation_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}